# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-shop.vercel.app

# ── Supabase (Project Settings → API) ────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API Setup)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=pick-any-random-string
WA_APP_SECRET=
WA_API_VERSION=v24.0
# Optional: approved template used for order alerts when the owner hasn't messaged the bot in 24h
WA_ORDER_TEMPLATE=
WA_TEMPLATE_LANG=en
# Optional: auto-reply to customers who message the bot number with the shop link
WA_CUSTOMER_AUTOREPLY=true
# Bootstrap: comma-separated owner numbers allowed to use the bot (also manageable in Dashboard → Settings)
OWNER_PHONES=923001234567

# ── AI ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Voice notes → text (OpenAI-compatible Whisper endpoint). Leave blank to disable voice notes.
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=whisper-1

# Karachi = UTC+5 → 300
STORE_TZ_OFFSET_MIN=300
